<style>
/* 首页文章列表卡片化样式 */
.main .article-list .article {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 12px;
  padding: 10px 22px 12px;
  margin-bottom: 12px;
  box-shadow: 0 1px 3px rgba(16,24,40,0.04);
  transition: all .25s ease;
}
.main .article-list .article .article-header {
  margin: 0;
  padding: 0;
}
.main .article-list .article h1 {
  margin: 0;
}
.main .article-list .article:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px -5px rgba(16,24,40,0.08), 0 4px 8px -4px rgba(16,24,40,0.05);
  border-color: rgba(33,150,243,0.15);
}
.main .article-list .article-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 8px 0;
}
.main .article-list .article-title a {
  color: #1f2a37;
}
.main .article-list .article-title a:hover {
  color: #2196f3;
}
.main .article-list .article-entry {
  color: #64748b;
  font-size: 13.5px;
  line-height: 1.6;
  margin-bottom: 8px;
}
.main .article-list .article-more-link a {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: #2563eb;
  font-size: 13.5px;
  font-weight: 500;
  text-decoration: none;
  transition: gap .15s ease;
}
.main .article-list .article-more-link a:hover {
  gap: 8px;
  color: #1d4ed8;
}
.main .article-list .article-meta {
  margin: 10px 0 0 0;
  padding-top: 10px;
  border-top: 1px solid #f1f5f9;
  font-size: 12px;
  color: #94a3b8;
}
.main .article-list .article-meta a {
  color: #64748b;
}
.main .article-list .article-meta a:hover {
  color: #2563eb;
}
.main .article-list .article-meta .article-category,
.main .article-list .article-meta .article-tag {
  margin-left: 12px;
}
</style>
<main class="main" role="main">
  <%- partial('_partial/archive-list', {index: true}) %>
  <%- partial('_partial/pagination', {type: 'page'}) %> 
</main>