<style>
/* 标签详情页卡片化样式 */
.article-tags .okayNav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  padding: 0;
  margin: 10px 0 16px 0;
}
.article-tags .okayNav ul li a {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 20px;
  background: #f1f5f9;
  color: #475569;
  font-size: 13px;
  text-decoration: none;
  transition: all .15s ease;
}
.article-tags .okayNav ul li a:hover {
  background: #dbeafe;
  color: #2563eb;
}
.article-tags .panel {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 10px;
  box-shadow: 0 1px 3px rgba(16,24,40,0.04);
  transition: all .2s ease;
  overflow: hidden;
}
.article-tags .panel:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 16px -4px rgba(16,24,40,0.1);
  border-color: rgba(33,150,243,0.15);
}
.article-tags .panel-body {
  padding: 12px 16px 4px 16px !important;
}
.article-tags .panel-footer {
  padding: 2px 16px 10px 16px !important;
  border-top: 1px solid #f5f7fa;
}
.article-tags .panel-footer .label.mb {
  margin-bottom: 0 !important;
}
.article-tags .article-meta {
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 2px;
}
.article-tags .panel .article-title {
  font-size: 15px !important;
  line-height: 1.5 !important;
  height: auto !important;
  margin: 0 !important;
  -webkit-line-clamp: 1 !important;
}
.article-tags .article-title a {
  color: #1f2a37;
}
.article-tags .article-title a:hover {
  color: #2196f3;
}
.article-tags .label {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  background: #f1f5f9;
  color: #64748b;
  font-size: 11px;
}
.article-tags .tag-group-title {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  margin: 0 0 16px 0;
  background: #f8fafc;
  border-bottom: 1px solid #eef2f7;
  border-radius: 8px;
}
.article-tags .tag-group-title .tag-name {
  font-size: 18px;
  font-weight: 600;
  color: #1e293b;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}
.article-tags .tag-group-title .tag-name i {
  font-size: 16px;
  color: #94a3b8;
}
.article-tags .tag-group-title .tag-count {
  display: inline-block;
  color: #94a3b8;
  font-size: 13px;
  font-weight: 400;
  margin-left: 8px;
}
</style>
<main class="main" role="main">
  <article class="content article article-tags post-type-list" itemscope="">
    <header class="article-header">
      <h1 class="tag-group-title"><span class="tag-name"><i class="icon icon-tag"></i><%= page.tag %></span><span class="tag-count">(Total <%= page.posts.length %> articles)</span></h1>
      <nav role="navigation" id="nav-main" class="okayNav">
        <ul>
          <li><a href="<%= config.root %>tags"><%= __('nav.all') %></a></li>
          <% site.tags.each(function(item){ %>
          <li><a href="<%= config.root %><%= item.path %>"><%= item.name %></a></li>
          <% }) %>
        </ul>
      </nav>
    </header>
    <!-- /header -->
    <div class="article-body">
      <div class="row">
        <%- partial('_partial/archive-tag', { type: 'tag' }) %>
      </div>
    </div>
  </article>
  <%- partial('_partial/pagination', {type: 'page'}) %> 
</main>