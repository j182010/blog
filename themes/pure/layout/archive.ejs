<style>
/* 归档页样式优化 */
.article-archives {
  max-width: 100%;
}
.article-archives .panel {
  background: #fff;
  border: 1px solid #eef2f7;
  border-radius: 12px;
  margin-bottom: 18px;
  box-shadow: 0 1px 3px rgba(16,24,40,0.04);
  overflow: hidden;
}
.article-archives .panel-heading {
  padding: 12px 18px;
  background: #f8fafc;
  border-bottom: 1px solid #eef2f7;
}
.article-archives .panel-title {
  display: flex;
  align-items: center;
}
.article-archives .panel-title a {
  color: #1e293b !important;
  font-size: 18px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
}
.article-archives .panel-title .archive-count {
  display: inline-block;
  color: #94a3b8;
  font-size: 13px;
  font-weight: 400;
  margin-left: 8px;
}
.article-archives .collection a.collection-item {
  display: flex;
  align-items: center;
  padding: 10px 18px;
  border-bottom: 1px solid #f5f7fa;
  color: #475569;
  transition: all .15s ease;
}
.article-archives .collection .collection-item:last-child {
  border-bottom: 0;
}
.article-archives .collection a.collection-item:hover {
  background: #f0f7ff;
  color: #2563eb !important;
  padding-left: 24px;
  transform: translateX(4px);
}
.article-archives .collection .collection-item time {
  color: #94a3b8;
  font-size: 13px;
  flex: none;
}
</style>
<%
  var title = page.title;
  if (is_archive()){
    title = __('page.archive');
    if (is_month()){
      title += ': ' + page.year + '/' + page.month;
    } else if (is_year()){
      title += ': ' + page.year;
    }
  }
%>
<main class="main" role="main">
  	<article class="content article article-archives article-type-list" itemscope="">
	    <header class="article-header">
	      <h1 itemprop="title"><% if (title){ %><%= title %><% } %></h1>
	      <p class="text-muted"><%= _p('total.article', site.posts.length) %></p>
	    </header>
	    <div class="article-body">
	      <%- partial('_partial/archive', {pagination: config.archive, index: true}) %>
	    </div>
  	</article>
  	<%- partial('_partial/pagination', {type: 'page'}) %> 	
</main>